<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    
    <!-- Assembly Metadata -->
    <AssemblyName>Pinkyu</AssemblyName>
    <RootNamespace>Pinkyu</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>Pinkyu</Authors>
    <Product>Pinkyu - Ping Tray Indicator</Product>
    <Description>Ultra-lightweight ping indicator in Windows system tray.</Description>
    <ApplicationIcon>app.ico</ApplicationIcon>
    
    <!-- Single-file self-contained settings -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

</Project>